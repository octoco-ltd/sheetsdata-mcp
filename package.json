  "keywords": [
    "mcp",
    "model-context-protocol",
    "oauth",
    "electronics",
    "datasheets",
    "components",
    "embedded",
    "hardware",
    "pcb",
    "eda"
  ],
  "homepage": "https://sheetsdata.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/octoco-ltd/sheetsdata-mcp.git"
  },
  "license": "MIT",
  "author": "Octoco Ltd",
  "type": "module",
  "bin": {
    "sheetsdata-mcp": "bin/cli.js"
  },
  "files": [
    "bin/",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test",
    "check-versions": "node scripts/versions.mjs check",
    "set-version": "node scripts/versions.mjs set",
    "release-notes": "node scripts/release-notes.mjs",
    "build-mcpb": "./scripts/build-mcpb.sh"
  },
  "dependencies": {
    "mcp-remote": "0.1.38"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "2.1.2"
